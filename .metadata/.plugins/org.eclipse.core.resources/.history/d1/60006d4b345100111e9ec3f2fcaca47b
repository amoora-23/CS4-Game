<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<StackPane minWidth="1024.0" minHeight="720.0" prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #111424;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.StartController">
   <children>
      
      <VBox alignment="CENTER" maxWidth="550.0" maxHeight="480.0" spacing="25.0" 
            style="-fx-background-color: #0b0d19; -fx-border-color: #3498db; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15; -fx-padding: 35;">
         
         <effect>
            <DropShadow radius="25.0" color="rgba(52, 152, 219, 0.25)" />
         </effect>

         <children>
            
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="DOOR DASH" textFill="#f1c40f" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 40px; -fx-letter-spacing: 3px;">
                     <effect>
                        <DropShadow radius="10.0" color="#f1c40f" opacity="0.4" />
                     </effect>
                  </Label>
                  <Label text="SCARE VS. LAUGH TOUCHDOWN" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 11px; -fx-letter-spacing: 2px;" />
               </children>
            </VBox>

            <Separator opacity="0.1" maxWidth="400.0" />
            <Label text="SELECT OPERATIONAL FACTION" textFill="#3498db" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px; -fx-letter-spacing: 1.5px;" />

            <HBox alignment="CENTER" spacing="25.0">
               <children>
                  
                  <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1c2e; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: rgba(0, 242, 254, 0.15); -fx-border-width: 1;">
                     <children>
                        <Label text="SCARE DIVISION" textFill="#00f2fe" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 12px; -fx-letter-spacing: 1px;" />
                        <Label text="Harness raw scream energy." textFill="#64748b" style="-fx-font-size: 11px;" />
                        <RadioButton fx:id="scarerBtn" text="DEPLOY SCARER" textFill="WHITE" style="-fx-font-family: 'Segoe UI Semibold'; -fx-cursor: hand;">
                           <toggleGroup>
                              <ToggleGroup fx:id="factionGroup" />
                           </toggleGroup>
                        </RadioButton>
                     </children>
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1c2e; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: rgba(243, 85, 136, 0.15); -fx-border-width: 1;">
                     <children>
                        <Label text="LAUGH DIVISION" textFill="#f35588" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 12px; -fx-letter-spacing: 1px;" />
                        <Label text="Generate comedy fuel matrix." textFill="#64748b" style="-fx-font-size: 11px;" />
                        <RadioButton fx:id="laugherBtn" text="DEPLOY LAUGHER" textFill="WHITE" toggleGroup="$factionGroup" style="-fx-font-family: 'Segoe UI Semibold'; -fx-cursor: hand;" />
                     </children>
                  </VBox>
                  
               </children>
            </HBox>

            <VBox alignment="CENTER" spacing="15.0" maxWidth="320.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button fx:id="startBtn" onAction="#handleStartGame" prefHeight="45.0" prefWidth="320.0" text="INITIALIZE PROTOCOL" />
                  <Button fx:id="howToPlayBtn" onAction="#showInstructions" prefHeight="35.0" prefWidth="200.0" text="MISSION DOSSIER" />
               </children>
            </VBox>

         </children>
      </VBox>
      
   </children>
</StackPane>