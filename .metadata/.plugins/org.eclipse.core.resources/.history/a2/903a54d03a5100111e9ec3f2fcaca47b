<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<StackPane minWidth="1024.0" minHeight="720.0" prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #111424;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.GameOverController">
   <children>
      
      <VBox alignment="CENTER" maxWidth="500.0" maxHeight="400.0" spacing="25.0" 
            style="-fx-background-color: #0b0d19; -fx-border-color: #f1c40f; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15; -fx-padding: 40;">
         
         <effect>
            <DropShadow radius="25.0" color="#f1c40f30" />
         </effect>

         <children>
            
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="VICTORY ACHIEVED" textFill="#2ecc71" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 36px; -fx-letter-spacing: 2px;">
                     <effect>
                        <DropShadow radius="8.0" color="#2ecc71" opacity="0.3" />
                     </effect>
                  </Label>
                  <Label text="FACILITY PROTOCOL TERMINATED" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 11px; -fx-letter-spacing: 1.5px;" />
               </children>
            </VBox>

            <Separator maxWidth="350.0" style="-fx-opacity: 0.1;" />

            <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #1a1c2e; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: rgba(241,196,15,0.15); -fx-border-width: 1;">
               <children>
                  <Label text="CHAMPION MANIFEST" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 10px;" />
                  <Label fx:id="winnerNameLabel" text="MONSTER_NAME" textFill="#f1c40f" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 24px;" />
                  <Label fx:id="winnerTextDetails" text="Touchdown criteria finalized successfully at Position 99." textFill="#64748b" style="-fx-font-size: 12px;" />
               </children>
            </VBox>

            <Button fx:id="restartBtn" onAction="#handleReturnToMenu" prefHeight="45.0" prefWidth="280.0" text="RETURN TO MISSION CONTROL" />
            
         </children>
      </VBox>
      
   </children>
</StackPane>