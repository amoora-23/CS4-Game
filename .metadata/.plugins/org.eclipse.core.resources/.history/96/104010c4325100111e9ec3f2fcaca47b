<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: #1a1a2e;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.StartController">
   <children>
      <Text fill="#3498db" strokeType="OUTSIDE" strokeWidth="0.0" text="DOOR DASH">
         <font>
            <Font name="System Bold" size="48.0" />
         </font>
      </Text>
      
      <HBox alignment="CENTER" spacing="50.0">
         <children>
            <ToggleButton fx:id="scarerBtn" prefHeight="150.0" prefWidth="150.0" text="SCARER">
               <toggleGroup>
                  <ToggleGroup fx:id="roleGroup" />
               </toggleGroup>
            </ToggleButton>
            <ToggleButton fx:id="laugherBtn" prefHeight="150.0" prefWidth="150.0" text="LAUGHER" toggleGroup="$roleGroup" />
         </children>
      </HBox>
      
      <Button fx:id="startButton" onAction="#handleStartGame" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #2980b9;" text="START MISSION" textFill="WHITE" />
      <Button onAction="#showInstructions" text="HOW TO PLAY" />
   </children>
</VBox>