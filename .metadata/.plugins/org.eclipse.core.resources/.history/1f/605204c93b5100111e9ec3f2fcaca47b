        javafx.scene.effect.DropShadow glow = new javafx.scene.effect.DropShadow(20, javafx.scene.paint.Color.web("#3498db"));
        layout.setEffect(glow);

        javafx.scene.Scene scene = new javafx.scene.Scene(layout, 500, 460);
