<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="22.0"
      style="-fx-background-color: #111424; -fx-padding: 60;"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="game.gui.controllers.GameOverController">

   <Label text="GAME OVER" textFill="#e74c3c"
          style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 28px; -fx-letter-spacing: 4px;" />

   <!-- Winner block -->
   <VBox alignment="CENTER" spacing="8.0"
         style="-fx-background-color: #0b0d19; -fx-padding: 28;
                -fx-background-radius: 12; -fx-border-color: #f1c40f;
                -fx-border-width: 2; -fx-border-radius: 12; -fx-min-width: 500;">
      <Label fx:id="winnerNameLabel" text="WINNER"
             textFill="#f1c40f"
             style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 32px;" />
      <Label fx:id="winnerRoleLabel" text="ROLE: —   |   TYPE: —"
             textFill="#94a3b8"
             style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 14px;" />
      <Label fx:id="winnerEnergyLabel" text="Final Energy: —"
             textFill="#2ecc71"
             style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 18px;" />
   </VBox>

   <!-- Both monsters' final energies -->
   <VBox alignment="CENTER_LEFT" spacing="6.0"
         style="-fx-background-color: #1a1c2e; -fx-padding: 16;
                -fx-background-radius: 8; -fx-border-color: #34495e;
                -fx-border-width: 1; -fx-border-radius: 8; -fx-min-width: 500;">
      <Label text="FINAL STANDINGS" textFill="#94a3b8"
             style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px; -fx-letter-spacing: 1px;" />
      <Label fx:id="player1FinalLabel" text="Player 1: — energy"
             textFill="white" style="-fx-font-size: 14px;" />
      <Label fx:id="player2FinalLabel" text="Player 2: — energy"
             textFill="white" style="-fx-font-size: 14px;" />
   </VBox>

   <Label fx:id="resultMessageLabel" text=""
          textFill="#bdc3c7"
          style="-fx-font-size: 13px;" wrapText="true" />

   <HBox alignment="CENTER" spacing="24.0">
      <Button fx:id="restartBtn" onAction="#handleReturnToMenu"
              prefHeight="44.0" prefWidth="160.0" text="PLAY AGAIN" />
      <Button fx:id="exitBtn" onAction="#handleExit"
              prefHeight="44.0" prefWidth="160.0" text="EXIT GAME" />
   </HBox>

</VBox>