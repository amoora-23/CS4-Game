<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    GameBoard.fxml — Milestone 3 Update
    New features wired:
      • player type, role, position labels on both sidebars
      • diceResultLabel  (dice roll display)
      • cardDeckCountLabel (remaining cards)
      • cardNameLabel / cardDescriptionLabel (drawn card info)
      • Cell click → popup (handled in controller)
      • Floating energy-delta animations (handled in controller)
-->
<BorderPane minWidth="1280.0" minHeight="760.0" prefHeight="810.0" prefWidth="1366.0"
            style="-fx-background-color: #111424;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="game.gui.controllers.GameBoardController">

   <!-- ═══════════════════════ LEFT SIDEBAR (Player 1) ═══════════════════════ -->
   <left>
      <VBox minWidth="240.0" prefWidth="240.0" spacing="10.0"
            style="-fx-background-color: #0b0d19; -fx-padding: 20;
                   -fx-border-color: rgba(0,242,254,0.15); -fx-border-width: 0 1 0 0;">

         <!-- Header -->
         <Label text="YOUR MONITOR" textFill="#00f2fe"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 13px; -fx-letter-spacing: 1px;" />
         <Separator opacity="0.2" />

         <!-- Name -->
         <Label fx:id="player1NameLabel" text="Player 1" textFill="white"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 15px;" />

         <!-- Type + Role -->
         <Label fx:id="player1TypeLabel" text="TYPE: —"
                textFill="#94a3b8" style="-fx-font-size: 11px;" />
         <Label fx:id="player1RoleLabel" text="ROLE: —"
                textFill="#94a3b8" style="-fx-font-size: 11px;" />

         <!-- Energy -->
         <Label fx:id="player1EnergyLabel" text="⚡ 0 / 1000"
                textFill="#00f2fe" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px;" />
         <ProgressBar fx:id="player1ProgressBar" prefWidth="200.0" progress="0.0"
                      style="-fx-accent: #00f2fe;" />

         <!-- Position -->
         <Label fx:id="player1PositionLabel" text="📍 Cell 0"
                textFill="#64748b" style="-fx-font-size: 11px;" />

         <!-- Status effects -->
         <Label text="STATUS" textFill="#00f2fe"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 10px; -fx-letter-spacing: 0.5px;" />
         <Label fx:id="player1StatusLabel" text="✅ OPERATIONAL"
                textFill="#2ecc71" style="-fx-font-size: 11px;" wrapText="true" />

         <VBox VBox.vgrow="ALWAYS" />

         <!-- Game log -->
         <Label text="TRANSMISSION FEED" textFill="#00f2fe"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 10px;" />
         <TextArea fx:id="gameLog" editable="false" prefHeight="160.0" wrapText="true"
                   style="-fx-control-inner-background: #111424; -fx-text-fill: #2ecc71;
                          -fx-font-family: 'Consolas', monospace; -fx-font-size: 10px;" />
      </VBox>
   </left>

   <!-- ═══════════════════════════ CENTER ════════════════════════════════════ -->
   <center>
      <VBox alignment="CENTER" spacing="14.0" style="-fx-padding: 14;">

         <!-- Turn indicator -->
         <Label fx:id="turnLabel" text="PLAYER 1 TURN" textFill="#f1c40f"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 18px; -fx-letter-spacing: 1.5px;" />

         <!-- Dice result -->
         <Label fx:id="diceResultLabel" text="🎲 Roll the dice!"
                textFill="#ecf0f1"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 22px;" />

         <!-- Board -->
         <GridPane fx:id="gameBoardGrid" alignment="CENTER"
                   minWidth="620.0" minHeight="620.0"
                   style="-fx-background-color: #1a1c2e; -fx-padding: 10; -fx-background-radius: 10;" />

         <!-- Action buttons -->
         <HBox alignment="CENTER" spacing="28.0">
            <Button fx:id="rollDiceBtn" onAction="#handleRollDice"
                    prefHeight="46.0" prefWidth="185.0"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: #111424;
                           -fx-font-family: 'Segoe UI Black'; -fx-font-size: 13px;
                           -fx-background-radius: 22; -fx-cursor: hand;"
                    text="🎲  ROLL DICE" />
            <Button fx:id="powerUpButton" onAction="#handleUsePowerUp"
                    prefHeight="46.0" prefWidth="185.0"
                    style="-fx-background-color: #f1c40f; -fx-text-fill: #111424;
                           -fx-font-family: 'Segoe UI Black'; -fx-font-size: 13px;
                           -fx-background-radius: 22; -fx-cursor: hand;"
                    text="⚡  USE POWER-UP" />
         </HBox>

         <!-- Cell-type legend -->
         <HBox alignment="CENTER" spacing="12.0" style="-fx-padding: 4 0 0 0;">
            <Label text="■ Door-S" style="-fx-text-fill: #8e44ad; -fx-font-size: 10px;" />
            <Label text="■ Door-L" style="-fx-text-fill: #6c5ce7; -fx-font-size: 10px;" />
            <Label text="■ Sock"   style="-fx-text-fill: #d35400; -fx-font-size: 10px;" />
            <Label text="■ Belt"   style="-fx-text-fill: #27ae60; -fx-font-size: 10px;" />
            <Label text="■ Card"   style="-fx-text-fill: #c0392b; -fx-font-size: 10px;" />
            <Label text="■ Monster" style="-fx-text-fill: #2980b9; -fx-font-size: 10px;" />
            <Label text="□ Exhausted" style="-fx-text-fill: #888888; -fx-font-size: 10px;" />
         </HBox>

      </VBox>
   </center>

   <!-- ═══════════════════════ RIGHT SIDEBAR (Player 2 + Cards) ═════════════ -->
   <right>
      <VBox minWidth="240.0" prefWidth="240.0" spacing="10.0"
            style="-fx-background-color: #0b0d19; -fx-padding: 20;
                   -fx-border-color: rgba(243,85,136,0.15); -fx-border-width: 0 0 0 1;">

         <!-- Header -->
         <Label text="OPPONENT MONITOR" textFill="#f35588"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 13px; -fx-letter-spacing: 1px;" />
         <Separator opacity="0.2" />

         <!-- Name -->
         <Label fx:id="player2NameLabel" text="Player 2" textFill="white"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 15px;" />

         <!-- Type + Role -->
         <Label fx:id="player2TypeLabel" text="TYPE: —"
                textFill="#94a3b8" style="-fx-font-size: 11px;" />
         <Label fx:id="player2RoleLabel" text="ROLE: —"
                textFill="#94a3b8" style="-fx-font-size: 11px;" />

         <!-- Energy -->
         <Label fx:id="player2EnergyLabel" text="⚡ 0 / 1000"
                textFill="#f35588" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 13px;" />
         <ProgressBar fx:id="player2ProgressBar" prefWidth="200.0" progress="0.0"
                      style="-fx-accent: #f35588;" />

         <!-- Position -->
         <Label fx:id="player2PositionLabel" text="📍 Cell 0"
                textFill="#64748b" style="-fx-font-size: 11px;" />

         <!-- Status -->
         <Label text="STATUS" textFill="#f35588"
                style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 10px; -fx-letter-spacing: 0.5px;" />
         <Label fx:id="player2StatusLabel" text="✅ OPERATIONAL"
                textFill="#2ecc71" style="-fx-font-size: 11px;" wrapText="true" />

         <VBox VBox.vgrow="ALWAYS" />

         <!-- ── Card Panel ── -->
         <VBox spacing="6.0" style="-fx-padding: 6 0 0 0;">

            <!-- Deck count -->
            <HBox alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #1a1c2e; -fx-padding: 8;
                         -fx-background-radius: 6; -fx-border-color: #c0392b;
                         -fx-border-width: 1; -fx-border-radius: 6;">
               <Label text="FACTORY DECK" textFill="#c0392b"
                      style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 10px;" />
               <Label fx:id="cardDeckCountLabel" text="🃏 — cards remaining"
                      textFill="#ecf0f1" style="-fx-font-size: 11px;" />
            </HBox>

            <!-- Last drawn card info -->
            <VBox spacing="5.0"
                  style="-fx-background-color: #111424; -fx-padding: 10;
                         -fx-border-color: #f1c40f; -fx-border-width: 1;
                         -fx-background-radius: 6; -fx-border-radius: 6;">
               <Label text="LAST DRAWN CARD" textFill="#94a3b8"
                      style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 9px; -fx-letter-spacing: 0.5px;" />
               <Label fx:id="cardNameLabel" text="DECK STANDBY"
                      textFill="#f1c40f"
                      style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 12px;" wrapText="true"/>
               <Label fx:id="cardDescriptionLabel" text="Awaiting card cell event."
                      textFill="#94a3b8" wrapText="true"
                      style="-fx-font-size: 10px; -fx-line-spacing: 1.1;" />
            </VBox>

         </VBox>

      </VBox>
   </right>

</BorderPane>
