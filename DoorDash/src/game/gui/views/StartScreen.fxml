<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import java.lang.String?>
<?import javafx.collections.FXCollections?>

<StackPane minWidth="1024.0" minHeight="720.0" prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: #111424;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="game.gui.controllers.StartController">
   <children>
      
      <VBox fx:id="mainMenuPane" alignment="CENTER" maxWidth="550.0" maxHeight="520.0" spacing="22.0" 
            style="-fx-background-color: #0b0d19; -fx-border-color: #3498db; -fx-border-width: 2; -fx-background-radius: 15; -fx-border-radius: 15; -fx-padding: 35;">
         <effect>
            <DropShadow radius="25.0" color="#3498db40" />
         </effect>
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="DOOR DASH" textFill="#f1c40f" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 40px; -fx-letter-spacing: 3px;">
                     <effect>
                        <DropShadow radius="10.0" color="#f1c40f" />
                     </effect>
                  </Label>
                  <Label text="SCARE VS. LAUGH TOUCHDOWN" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 11px; -fx-letter-spacing: 2px;" />
               </children>
            </VBox>

            <Separator maxWidth="400.0" style="-fx-opacity: 0.1;" />
            
            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="CHOOSE COMBAT MATRIX" textFill="#3498db" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px; -fx-letter-spacing: 1.5px;" />
                  <ComboBox fx:id="gameModeBox" prefWidth="320.0" style="-fx-background-color: #1a1c2e; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: rgba(52, 152, 219, 0.3); -fx-border-radius: 8;">
                     <items>
                        <FXCollections fx:factory="observableArrayList">
                           <String fx:value="1 VS BOT (SOLO TRAINING)" />
                           <String fx:value="1 VS 1 (LOCAL MULTIPLAYER)" />
                        </FXCollections>
                     </items>
                  </ComboBox>
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label text="SELECT OPERATIONAL FACTION" textFill="#3498db" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px; -fx-letter-spacing: 1.5px;" />
                  <HBox alignment="CENTER" spacing="25.0">
                     <children>
                        <VBox alignment="CENTER" spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1c2e; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(0, 242, 254, 0.15); -fx-border-width: 1;">
                           <children>
                              <Label text="SCARE DIVISION" textFill="#00f2fe" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 12px; -fx-letter-spacing: 1px;" />
                              <RadioButton fx:id="scarerBtn" text="DEPLOY SCARER" textFill="WHITE" style="-fx-font-family: 'Segoe UI Semibold'; -fx-cursor: hand;">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="factionGroup" />
                                 </toggleGroup>
                              </RadioButton>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #1a1c2e; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: rgba(243, 85, 136, 0.15); -fx-border-width: 1;">
                           <children>
                              <Label text="LAUGH DIVISION" textFill="#f35588" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 12px; -fx-letter-spacing: 1px;" />
                              <RadioButton fx:id="laugherBtn" text="DEPLOY LAUGHER" textFill="WHITE" toggleGroup="$factionGroup" style="-fx-font-family: 'Segoe UI Semibold'; -fx-cursor: hand;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="15.0" maxWidth="320.0" style="-fx-padding: 5 0 0 0;">
               <children>
                  <Button fx:id="startBtn" onAction="#handleStartGame" prefHeight="45.0" prefWidth="320.0" text="INITIALIZE PROTOCOL" />
                  <Button fx:id="howToPlayBtn" onAction="#showInstructions" prefHeight="35.0" prefWidth="200.0" text="MISSION DOSSIER" />
               </children>
            </VBox>
         </children>
      </VBox>

      <VBox fx:id="briefingPane" alignment="CENTER" spacing="35.0" visible="false" managed="false" style="-fx-background-color: #111424; -fx-padding: 50;">
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="MATCH CONFIGURATION MANIFEST" textFill="#f1c40f" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 32px; -fx-letter-spacing: 2px;">
                     <effect>
                        <DropShadow radius="12.0" color="#f1c40f30" />
                     </effect>
                  </Label>
                  <Label text="SECURE DATA INFRASTRUCTURE SYNCHRONIZED" textFill="#64748b" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 12px; -fx-letter-spacing: 2.5px;" />
               </children>
            </VBox>

            <Separator maxWidth="600.0" style="-fx-opacity: 0.1;" />

            <HBox alignment="CENTER" spacing="40.0" maxWidth="950.0">
               <children>
                  <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #0b0d19; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #00f2fe; -fx-border-width: 2;">
                     <children>
                        <Label text="YOUR ASSIGNED OPERATIVE" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px;" />
                        <Label fx:id="lblUserName" text="NAME" textFill="#00f2fe" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 24px;" />
                        <Label fx:id="lblUserType" text="CLASS:" textFill="WHITE" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 14px;" />
                        <Label fx:id="lblUserEnergy" text="ENERGY:" textFill="#2ecc71" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 14px;" />
                     </children>
                  </VBox>

                  <Label text="VS" textFill="#334155" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 26px;" />

                  <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #0b0d19; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #f35588; -fx-border-width: 2;">
                     <children>
                        <Label text="TARGET OPPONENT SYSTEM" textFill="#94a3b8" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 11px;" />
                        <Label fx:id="lblOppName" text="NAME" textFill="#f35588" style="-fx-font-family: 'Segoe UI Black'; -fx-font-size: 24px;" />
                        <Label fx:id="lblOppType" text="CLASS:" textFill="WHITE" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 14px;" />
                        <Label fx:id="lblOppEnergy" text="ENERGY:" textFill="#2ecc71" style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 14px;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Button fx:id="commenceMatchBtn" onAction="#handleCommenceMatch" prefHeight="50.0" prefWidth="320.0" text="COMMENCE MATCH SEQUENCE" />
            <Button onAction="#handleCloseWindow"
        text="✕"
        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;
               -fx-font-size: 18px; -fx-cursor: hand;"
        prefWidth="36" prefHeight="36">
    <StackPane.alignment>
        <javafx.geometry.Pos fx:constant="TOP_RIGHT"/>
    </StackPane.alignment>
    <StackPane.margin>
        <javafx.geometry.Insets top="10" right="10"/>
    </StackPane.margin>
</Button>
         </children>
      </VBox>
      
   </children>
</StackPane>